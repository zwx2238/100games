    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
